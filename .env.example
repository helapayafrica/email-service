PORT=3000
# Public URL used in startup logs. Use the HTTPS VPS domain in production.
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=emailservice
DB_PASS=emailservice
DB_NAME=emailservice
REDIS_HOST=localhost
REDIS_PORT=6379

# PRODUCTION SMTP — keep these commented during local development.
# Before deploying, remove the Mailpit values below and configure these through
# your production secret/environment manager. Never commit real credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-production-username
# SMTP_PASS=your-production-password
# SMTP_FROM=Website Contact <no-reply@example.com>

# LOCAL DEVELOPMENT ONLY — Mailpit captures messages instead of sending them.
# Do not use these values in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Website Contact <no-reply@email-service.local>

# Comma-separated browser origins. Required in production.
CORS_ORIGINS=https://www.example.com,https://example.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# Sites (companies) live in the database, not here. Log in as a super-admin
# and use POST /admin/sites (see /docs). Old SITE_<ID>_* vars can be imported
# once with: npm run site:import-env -- --from-file .env

# Signs login tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Development only: prefills the POST /auth/login example in /docs, e.g. with
# your local super-admin. Ignored when NODE_ENV=production; never set these on a server.
DOCS_LOGIN_EMAIL=
DOCS_LOGIN_PASSWORD=

# Encrypts per-site secrets (SMTP passwords, API keys) stored in the database.
# Generate with: openssl rand -base64 32. Losing it makes stored secrets unreadable.
SITE_SECRETS_KEY=
