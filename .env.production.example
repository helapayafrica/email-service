NODE_ENV=production
PORT=3000
APP_URL=https://email-api.example.com

# Inside Compose, the application uses postgres:5432 and redis:6379.
DB_USER=emailservice
DB_PASS=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_NAME=emailservice

SMTP_HOST=smtp.production-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Website Contact <contact@example.com>

CORS_ORIGINS=https://www.example.com,https://example.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# Sites (companies) live in the database and are managed by a super-admin
# through /admin/sites. Servers upgraded from the env-based setup keep their
# SITE_<ID>_* lines here until the import has run and the release is stable:
# see docs/DEPLOY_DASHBOARD_AUTH.md.

# Signs login tokens. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
JWT_EXPIRES_IN_SECONDS=3600

# openssl rand -base64 32. Back this up: without it, site secrets can't be decrypted.
SITE_SECRETS_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
